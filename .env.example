# ─────────────────────────────────────────────────────────────────────────
#  CA Photographies — configuration serveur
#  Copier ce fichier en `.env` et le remplir. Le `.env` n'est JAMAIS commité.
#  Sur EX2, placer le `.env` à la racine du projet (hors du DocumentRoot).
# ─────────────────────────────────────────────────────────────────────────

# local | production
APP_ENV=local
# URL publique du site, sans slash final
APP_URL=http://localhost:8080
# Clé secrète aléatoire (sessions, CSRF). Générer : php -r "echo bin2hex(random_bytes(32));"
APP_KEY=changez-moi

# Base de données
#   Local :      sqlite:storage/database.sqlite
#   EX2 (cPanel) : mysql://utilisateur:motdepasse@localhost:3306/nom_de_base
DATABASE_URL=sqlite:storage/database.sqlite

# ── Stockage des photos ──────────────────────────────────────────────────
# Le backend tourne SUR l'hébergement EX2 : il accède aux fichiers directement
# par le système de fichiers. Aucun identifiant FTP/SFTP n'est nécessaire.
#
# Nouveaux uploads (structure propre, indépendante de WordPress)
#   EX2 : /home/<compte>/public_html/photos   et   https://caphotographies.fr/photos
PHOTOS_ROOT=storage/media/photos
PHOTOS_URL=/photos

# Photos héritées de WordPress (référencées EN PLACE, jamais modifiées)
#   EX2 : /home/<compte>/public_html/wp-content/uploads
LEGACY_ROOT=storage/media/legacy
LEGACY_URL=https://caphotographies.fr/wp-content/uploads

# Dossier temporaire des chunks d'upload (hors DocumentRoot)
UPLOAD_TMP=storage/uploads
# Taille d'un chunk envoyé par le navigateur (octets). 4 Mo passe partout sur cPanel.
UPLOAD_CHUNK_SIZE=4194304

# Corbeille : les suppressions déplacent les fichiers ici (relatif à PHOTOS_ROOT)
TRASH_DIR=_corbeille

# Génération des versions web : auto | imagick | gd
IMAGE_DRIVER=auto
# Largeurs générées (px), séparées par des virgules. La miniature est toujours générée.
IMAGE_SIZES=800,1600,2400
IMAGE_THUMB_WIDTH=640
IMAGE_QUALITY=82
# webp | jpeg — format des versions web (l'original est conservé tel quel)
IMAGE_FORMAT=webp

# ── Import WordPress (script bin/import-wordpress.php) ───────────────────
WP_API_URL=https://caphotographies.fr/wp-json/wp/v2

# ── Sauvegardes (bin/backup.php) ─────────────────────────────────────────
BACKUP_DIR=storage/backups
BACKUP_KEEP=14
